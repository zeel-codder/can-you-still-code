{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "can-you-still-code",
  "compatibility_date": "2026-10-06",
  // Fills in the site's own origin in index.html's link-preview tags (see worker/index.ts).
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker; hashed JS/CSS bundles skip it.
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
